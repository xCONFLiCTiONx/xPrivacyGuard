 pub fn apply(socket: SockRef<'_>) -> io::Result<()> {
+    #[cfg(target_os = "android")]
+    {
+        let callback = ANDROID_SOCKET_PROTECTOR.load(Ordering::SeqCst);
+        if callback == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "Android VpnService socket protection callback is not registered",
+            ));
+        }
+        let protect: AndroidSocketProtector = unsafe { std::mem::transmute(callback) };
+        if protect(socket.as_raw_fd()) != 1 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "Android VpnService.protect(fd) rejected the Aether socket",
+            ));
+        }
+    }
