+pub type AndroidSocketProtector = extern "C" fn(i32) -> i32;
+
+pub fn set_android_socket_protector(callback: Option<AndroidSocketProtector>) {
+    ANDROID_SOCKET_PROTECTOR.store(
+        callback.map_or(0, |function| function as usize),
+        Ordering::SeqCst,
+    );
+}
 
