{
  "manifest_version": 3,
  "name": "xPrivacy Guard Mobile",
  "short_name": "xPrivacy Guard",
  "version": "2.0.1",
  "description": "Comprehensive mobile privacy shield: Global Privacy Control (GPC), Do Not Track (DNT), URL tracking parameter sanitizer, and fingerprinting defense.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon48.png",
      "32": "icons/icon48.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "xPrivacy Guard Mobile",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gpc_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon48.png",
    "32": "icons/icon48.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
