{
  "manifest_version": 3,
  "name": "xPrivacyGuard",
  "version": "2.0.0",
  "description": "Advanced browser fingerprint and tracking surface protection.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "xPrivacyGuard"
  }
}
