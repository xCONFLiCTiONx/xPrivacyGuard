{
  "manifest_version": 3,
  "name": "xPrivacyGuard",
  "version": "2.0.0",
  "description": "Advanced browser fingerprint and tracking surface protection.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "xPrivacyGuard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "renderIcon.js"
      ],
      "run_at": "document_start"
    }
  ]
}
