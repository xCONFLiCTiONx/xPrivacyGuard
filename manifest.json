{
  "manifest_version": 3,
  "name": "xPrivacyGuard",
  "version": "2.0.0",
  "description": "Advanced browser fingerprint and tracking surface protection.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "xPrivacyGuard"
  }
}
